rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /ocorrencias/{ocorrenciaId} {
      // Leitura pública dos relatos comunitários; não inclua dados pessoais nos documentos.
      allow read: if true;

      // Somente usuários autenticados podem criar relatos novos, sempre pendentes e em seu nome.
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'categoria', 'local', 'descricao', 'latitude', 'longitude',
          'status', 'ownerUid', 'criadoEm'
        ])
        && request.resource.data.categoria is string
        && request.resource.data.categoria.size() <= 120
        && request.resource.data.local is string
        && request.resource.data.local.size() <= 120
        && request.resource.data.descricao is string
        && request.resource.data.descricao.size() > 0
        && request.resource.data.descricao.size() <= 1000
        && request.resource.data.status == 'Pendente'
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.criadoEm == request.time
        && (request.resource.data.latitude == null || request.resource.data.latitude is number)
        && (request.resource.data.longitude == null || request.resource.data.longitude is number);

      // A claim admin só pode ser atribuída por código confiável usando Firebase Admin SDK.
      allow update, delete: if isAdmin();
    }

    match /perfis/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'cidade', 'atualizadoEm'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() <= 80
        && request.resource.data.cidade is string
        && request.resource.data.cidade.size() <= 100;
      allow delete: if isAdmin();
    }
  }
}