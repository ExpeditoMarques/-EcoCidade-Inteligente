rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'expeditomar28@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function hasMunicipalAssignment(uid) {
      return exists(/databases/$(database)/documents/adminAssignments/$(uid));
    }
    function isMunicipalAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && hasMunicipalAssignment(request.auth.uid)
        && get(/databases/$(database)/documents/adminAssignments/$(request.auth.uid)).data.role == 'municipal_admin'
        && get(/databases/$(database)/documents/adminAssignments/$(request.auth.uid)).data.emailLower == request.auth.token.email;
    }
    function assignedMunicipalityId() {
      return get(/databases/$(database)/documents/adminAssignments/$(request.auth.uid)).data.municipioId;
    }
    function canManageOccurrence(data) {
      return isAdmin() || (isMunicipalAdmin() && data.municipioId == assignedMunicipalityId());
    }

    match /ocorrencias/{ocorrenciaId} {
      // A consulta pública permite que visitantes vejam ocorrências de todos os municípios,
      // inclusive pendentes. Edição e exclusão continuam limitadas por município.
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll([
          'categoria', 'local', 'descricao', 'latitude', 'longitude', 'status', 'criadoEm', 'municipioId', 'municipio'
        ])
        && request.resource.data.keys().hasOnly([
          'categoria', 'local', 'descricao', 'latitude', 'longitude', 'status', 'criadoEm', 'ownerUid', 'municipioId', 'municipio'
        ])
        && request.resource.data.categoria is string
        && request.resource.data.categoria.size() > 0
        && request.resource.data.categoria.size() <= 120
        && request.resource.data.local is string
        && request.resource.data.local.size() <= 120
        && request.resource.data.descricao is string
        && request.resource.data.descricao.size() > 0
        && request.resource.data.descricao.size() <= 1000
        && request.resource.data.municipioId is string
        && request.resource.data.municipioId.size() > 0
        && request.resource.data.municipio is string
        && request.resource.data.municipio.size() <= 120
        && exists(/databases/$(database)/documents/municipios/$(request.resource.data.municipioId))
        && request.resource.data.status == 'Pendente'
        && request.resource.data.criadoEm == request.time
        && (request.resource.data.latitude == null || request.resource.data.latitude is number)
        && (request.resource.data.longitude == null || request.resource.data.longitude is number)
        && (!('ownerUid' in request.resource.data.keys()) || (signedIn() && request.resource.data.ownerUid == request.auth.uid));
      allow update: if canManageOccurrence(resource.data)
        && request.resource.data.municipioId == resource.data.municipioId;
      allow delete: if canManageOccurrence(resource.data);
    }

    function validInvite(token) {
      return token is string
        && exists(/databases/$(database)/documents/adminInvites/$(token))
        && get(/databases/$(database)/documents/adminInvites/$(token)).data.used == false
        && get(/databases/$(database)/documents/adminInvites/$(token)).data.role == 'municipal_admin'
        && get(/databases/$(database)/documents/adminInvites/$(token)).data.expiresAt > request.time
        && (get(/databases/$(database)/documents/adminInvites/$(token)).data.invitedEmail == ''
            || get(/databases/$(database)/documents/adminInvites/$(token)).data.invitedEmail == request.auth.token.email);
    }

    match /adminInvites/{token} {
      // O token aleatório funciona como segredo do convite. Só o admin geral cria convites.
      allow read: if isAdmin() || (resource.data.used == false && resource.data.expiresAt > request.time);
      allow create: if isAdmin()
        && request.resource.data.token == token
        && request.resource.data.role == 'municipal_admin'
        && request.resource.data.municipioId is string
        && request.resource.data.used == false
        && request.resource.data.expiresAt > request.time
        && exists(/databases/$(database)/documents/municipios/$(request.resource.data.municipioId));
      allow update: if signedIn()
        && resource.data.used == false
        && resource.data.expiresAt > request.time
        && request.resource.data.token == token
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedByEmail == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used','usedBy','usedByEmail','usedAt']);
      allow delete: if isAdmin();
    }

    match /adminAssignments/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.auth.token.email_verified == true
          && request.resource.data.role == 'municipal_admin'
          && request.resource.data.emailLower == request.auth.token.email
          && validInvite(request.resource.data.inviteToken)
          && request.resource.data.municipioId == get(/databases/$(database)/documents/adminInvites/$(request.resource.data.inviteToken)).data.municipioId
          && getAfter(/databases/$(database)/documents/adminInvites/$(request.resource.data.inviteToken)).data.used == true
          && getAfter(/databases/$(database)/documents/adminInvites/$(request.resource.data.inviteToken)).data.usedBy == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }


    match /conteudosPublicos/{contentId} {
      // Visitantes só leem itens publicados; admins podem consultar o conteúdo que gerenciam.
      allow read: if (resource.data.publicado == true) || isAdmin()
        || (isMunicipalAdmin() && resource.data.municipioId == assignedMunicipalityId());
      allow create: if isAdmin()
        || (isMunicipalAdmin()
          && request.resource.data.municipioId == assignedMunicipalityId()
          && request.resource.data.secao in ['guia','acoes','conquistas','inicio']
          && request.resource.data.titulo is string
          && request.resource.data.titulo.size() > 0
          && request.resource.data.titulo.size() <= 120
          && request.resource.data.descricao is string
          && request.resource.data.descricao.size() <= 1800);
      allow update: if isAdmin()
        || (isMunicipalAdmin()
          && resource.data.municipioId == assignedMunicipalityId()
          && request.resource.data.municipioId == assignedMunicipalityId()
          && request.resource.data.secao in ['guia','acoes','conquistas','inicio']
          && request.resource.data.titulo is string
          && request.resource.data.titulo.size() > 0
          && request.resource.data.titulo.size() <= 120
          && request.resource.data.descricao is string
          && request.resource.data.descricao.size() <= 1800);
      allow delete: if isAdmin()
        || (isMunicipalAdmin() && resource.data.municipioId == assignedMunicipalityId());
    }

    match /conteudoSite/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /acoesComunitarias/{acaoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /guiaSustentavel/{dicaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /regrasPontos/{regraId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /perfis/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.token.email_verified == true && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'cidade', 'fotoURL', 'email', 'atualizadoEm'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 80
        && request.resource.data.cidade is string && request.resource.data.cidade.size() <= 100
        && request.resource.data.fotoURL is string && request.resource.data.fotoURL.size() <= 2048
        && request.resource.data.email is string && request.resource.data.email.size() <= 254;
      allow delete: if isAdmin();
    }
    match /userStats/{uid} {
      // Cada visitante lê e atualiza apenas a própria pontuação; o administrador geral pode auditar.
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['points','quizAwarded','badges','answeredQuestions','updatedAt'])
        && request.resource.data.points is number
        && request.resource.data.points >= 0
        && request.resource.data.points <= 100000
        && request.resource.data.quizAwarded is bool
        && request.resource.data.badges is list
        && request.resource.data.answeredQuestions is list;
      allow delete: if isAdmin();
    }

    match /municipios/{municipioId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}